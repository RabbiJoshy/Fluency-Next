{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/lyrics-audit-bundle.schema.json",
  "title": "Portable lyrics song-audit bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "language", "artist", "song", "runs", "comparison", "evidence", "limitations"],
  "properties": {
    "schema": {"const": "fluency.lyrics-audit-bundle/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "language": {"type": "string", "minLength": 2},
    "artist": {"$ref": "#/$defs/namedEntity"},
    "song": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source", "lines"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "label", "role", "artifact_sha256"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "role": {"enum": ["baseline", "candidate", "reference"]},
          "artifact_sha256": {"type": ["string", "null"]}
        }
      }
    },
    "routing_profiles": {"type": "object", "additionalProperties": {"type": "object"}},
    "comparison": {"type": "object"},
    "evidence": {"type": "object", "additionalProperties": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "namedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "ordinal", "source_position", "text", "translation", "vocalists", "occurrences", "app_assignments"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "source_position": {"type": "integer", "minimum": 0},
        "text": {"type": "string"},
        "translation": {"type": ["object", "null"]},
        "vocalists": {"type": "array", "items": {"type": "string"}},
        "occurrences": {"type": "array", "items": {"type": "object"}},
        "app_assignments": {"type": "array", "items": {"type": "object"}},
        "source_ingest": {"type": ["object", "null"]}
      }
    }
  }
}
