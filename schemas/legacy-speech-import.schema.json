{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/legacy-speech-import.schema.json",
  "title": "Legacy split Speech import configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["import_version", "release_id", "language", "locale", "mode", "identity", "ranking_policy", "set_size"],
  "properties": {
    "import_version": {"const": "legacy-split-speech-import/v1"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "locale": {"type": "string", "minLength": 2},
    "mode": {"const": "speech"},
    "identity": {"const": "surface-card/v1"},
    "ranking_policy": {"type": "string", "minLength": 1},
    "set_size": {"type": "integer", "minimum": 1}
  }
}
