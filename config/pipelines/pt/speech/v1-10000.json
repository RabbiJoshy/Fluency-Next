{
  "profile_version": "speech-pipeline-profile/v1",
  "profile_id": "pt_speech_v1_10000",
  "language": "pt",
  "locale": "pt-PT",
  "mode": "speech",
  "identity": {
    "unit_type": "surface",
    "identity_version": "surface-card/v1",
    "allow_lemma_identity": false
  },
  "source_policy": {
    "fresh_snapshots_only": true,
    "allow_legacy_inputs": false,
    "allow_recovered_inputs": false,
    "fallback_policy": "none"
  },
  "scope": {
    "surface_limit": 10000,
    "shortfall_policy": "publish_explicit",
    "display_examples_per_card": [
      {
        "through_rank": 1000,
        "examples": 5
      },
      {
        "through_rank": 10000,
        "examples": 3
      }
    ]
  },
  "inventory": {
    "source_adapter": "published-surface-frequency-list/v1",
    "language_policy": "pt-v1",
    "source_edition": "FrequencyWords OpenSubtitles 2018 pt 50k (European)",
    "frequency_measure": "surface_token_occurrences",
    "output_schema": "surface-inventory/v1",
    "identity_unit": "surface",
    "lemma_role": "excluded"
  },
  "sense_menu": {
    "source_adapter": "wiktionary-sense-menu/v1",
    "language_policy": "pt-v1",
    "source_edition": "enwiktionary",
    "gloss_language": "en",
    "snapshot_id": null,
    "output_schema": "sense-menu/v1",
    "join_key": "surface_card_id",
    "lemma_role": "lookup_metadata_only"
  },
  "harvest": {
    "shared_policy": "speech-v1",
    "language_policy": "pt-v1",
    "source_policy": "explicit_union",
    "sources": [
      "tatoeba",
      "opensubtitles"
    ],
    "wsd_budget_per_card": [
      {
        "through_rank": 1000,
        "budget": 80
      },
      {
        "through_rank": 3000,
        "budget": 50
      },
      {
        "through_rank": 10000,
        "budget": 30
      }
    ],
    "source_share": {
      "tatoeba": 0.6,
      "opensubtitles": 0.4
    },
    "budget_note": "Headroom, not a display count. The harvest exists to let a sense distribution be estimated later from about 10 scored occurrences, and WSD will skip some of those, so the pool must hold well more than 10. Floor is 30 at the tail -- twice the 15 a card should almost always have, three times the 10 to be scored. Retaining more costs disk and nothing else: what reaches WSD is governed by execution_cap_per_card. This is the number that cannot be raised later without harvesting again."
  },
  "stage_order": [
    "inventory",
    "sense_menu",
    "sentence_harvest",
    "wsd_assignments",
    "example_selection",
    "release_build"
  ],
  "wsd": {
    "strategy": "language-adapted-closed-menu/v1",
    "shared_profile": "closed-menu-provider-prior-v1",
    "language_profile": "pt-v1",
    "model_profile": "pt-v7-1",
    "require_model_pins": true,
    "execution_status": "ready",
    "model_revisions": {
      "gloss.model_revision": "gemini-embedding-001",
      "occurrence_pos.model_revision": "pt_core_news_lg@3.8.0"
    },
    "max_wsd_units_per_run": 110000,
    "execution_cap_per_card": 10,
    "max_wsd_units_per_run_note": "10,000 surfaces x execution cap 10 = 100,000 units."
  },
  "release": {
    "activation": "manual",
    "fallback_policy": "none"
  }
}
