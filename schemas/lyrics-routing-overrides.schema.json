{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/lyrics-routing-overrides.schema.json",
  "title": "Typed and attributable human overrides for Lyrics routing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "lyrics-routing-overrides/v1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["override_id", "status", "language", "normalized_form", "decision", "reason", "author", "created_at", "scope"],
        "properties": {
          "override_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "status": {"enum": ["active", "revoked"]},
          "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
          "normalized_form": {"type": "string", "minLength": 1},
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "bucket", "target"],
            "properties": {
              "status": {"enum": ["excluded", "classified", "derived", "review"]},
              "bucket": {"type": "string", "minLength": 1},
              "target": {"type": ["string", "null"]}
            }
          },
          "reason": {"type": "string", "minLength": 1},
          "author": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "format": "date-time"},
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modes", "artist_ids", "song_ids"],
            "properties": {
              "modes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "artist_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "song_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "supersedes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
