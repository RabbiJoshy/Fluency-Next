{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/release-manifest.schema.json",
  "title": "Fluency compact release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "release_id",
    "language",
    "locale",
    "mode",
    "created_at",
    "publication_status",
    "card_count",
    "deck_path",
    "deck_content_id",
    "composition_path",
    "composition_content_id",
    "progress_namespace",
    "wsd",
    "app_contract"
  ],
  "properties": {
    "manifest_version": {
      "const": "release-manifest/v1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {"type": "string", "minLength": 2},
    "locale": {"type": "string", "minLength": 2},
    "mode": {"type": "string", "minLength": 1},
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_status": {"type": "string", "minLength": 1},
    "card_count": {
      "type": "integer",
      "minimum": 1
    },
    "deck_path": {
      "const": "deck.json"
    },
    "deck_content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "composition_path": {
      "const": "composition.json"
    },
    "composition_content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "progress_namespace": {"type": "string", "minLength": 1},
    "wsd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "status"],
      "properties": {
        "enabled": {"type": "boolean"},
        "status": {"type": "string", "minLength": 1},
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "app_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "index_path", "index_content_id", "examples_path", "examples_content_id"],
      "properties": {
        "contract_version": {"const": "fluency-split-speech/v1"},
        "index_path": {"const": "app/vocabulary.index.json"},
        "index_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "examples_path": {"const": "app/vocabulary.examples.json"},
        "examples_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "study_structure_path": {"const": "app/study-structure.json"},
        "study_structure_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "conjugations_path": {"const": "app/conjugations.json"},
        "conjugations_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
