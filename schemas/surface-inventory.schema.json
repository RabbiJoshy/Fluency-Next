{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/surface-inventory.schema.json",
  "title": "Ranked surface-only harvest inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "language", "cards"],
  "properties": {
    "inventory_version": {"const": "surface-inventory/v1"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "surface_key", "display_form", "rank"],
        "properties": {
          "card_id": {"type": "string", "pattern": "^card_[a-z]{2,3}_[0-9a-f]{32}$"},
          "surface_key": {"type": "string", "minLength": 1},
          "display_form": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
