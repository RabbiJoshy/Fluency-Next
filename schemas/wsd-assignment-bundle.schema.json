{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/wsd-assignment-bundle.schema.json",
  "title": "Complete external WSD result for one immutable pipeline run",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "run_id", "language", "mode", "coverage", "method", "inputs", "assignments"],
  "properties": {
    "bundle_version": {"const": "wsd-assignment-bundle/v1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "mode": {"const": "speech"},
    "coverage": {"const": "complete_candidate_pool"},
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "implementation_version", "implementation_content_id", "model_revisions", "random_seed"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "implementation_version": {"type": "string", "minLength": 1},
        "implementation_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_revisions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "random_seed": {"type": "integer", "minimum": 0}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "sense_menu", "candidates", "sentence_bank"],
      "properties": {
        "inventory": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sense_menu": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidates": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sentence_bank": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "assignments": {
      "type": "array",
      "items": {"$ref": "wsd-assignment.schema.json"}
    }
  }
}
