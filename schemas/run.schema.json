{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/run.schema.json",
  "title": "Fluency pipeline run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "language",
    "mode",
    "profile",
    "status",
    "created_at",
    "config_hash",
    "inputs",
    "stages"
  ],
  "properties": {
    "manifest_version": {"const": "run/v1"},
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "mode": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "status": {
      "enum": ["created", "running", "complete", "failed", "interrupted"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "stages": {"type": "array", "items": {"type": "string"}},
    "git_commit": {"type": "string", "minLength": 1}
  }
}

