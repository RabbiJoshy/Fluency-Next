{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/wsd-request-v2.schema.json",
  "title": "Mode-neutral WSD request bound to an exact analysis target and context",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "request_id", "run_id", "mode", "language", "target", "occurrence_id", "surface_card_id", "surface_form", "normalized_form", "eligibility", "lexical_candidate_id", "menu_reference", "context", "input_artifact_ids"],
  "properties": {
    "request_version": {"const": "wsd-request/v2"},
    "request_id": {"type": "string", "pattern": "^wsd_request_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["speech", "lyrics"]},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["sentence_candidate", "analysis_unit"]}, "id": {"type": "string", "minLength": 1}}
    },
    "occurrence_id": {"type": ["string", "null"]},
    "surface_card_id": {"type": "string", "pattern": "^card_[a-z]{2,3}_[0-9a-f]{32}$"},
    "surface_form": {"type": "string", "minLength": 1},
    "normalized_form": {"type": "string", "minLength": 1},
    "eligibility": {"enum": ["ready", "no_menu", "ineligible", "review"]},
    "lexical_candidate_id": {"type": "string", "pattern": "^lexical_[0-9a-f]{32}$"},
    "menu_reference": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["content_id", "lexical_candidate_id", "lookup_card_id", "lookup_form", "analysis_ids", "analysis_count", "sense_count"],
          "properties": {
            "content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "lexical_candidate_id": {"type": "string", "pattern": "^lexical_[0-9a-f]{32}$"},
            "lookup_card_id": {"type": "string", "pattern": "^card_[a-z]{2,3}_[0-9a-f]{32}$"},
            "lookup_form": {"type": "string", "minLength": 1},
            "analysis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^analysis_[0-9a-f]{32}$"}},
            "analysis_count": {"type": "integer", "minimum": 1},
            "sense_count": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "context_id", "song_id", "text", "target_span", "translation"],
      "properties": {
        "kind": {"enum": ["sentence", "lyrics_line"]},
        "context_id": {"type": "string", "minLength": 1},
        "song_id": {"type": ["string", "null"]},
        "text": {"type": "string", "minLength": 1},
        "target_span": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "items": false},
        "translation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["alignment_id", "language", "text", "source_snapshot_content_id"],
              "properties": {
                "alignment_id": {"type": "string", "minLength": 1},
                "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
                "text": {"type": "string", "minLength": 1},
                "source_snapshot_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          ]
        }
      }
    },
    "input_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
  },
  "allOf": [
    {
      "if": {"properties": {"eligibility": {"const": "ready"}}},
      "then": {"properties": {"menu_reference": {"type": "object"}}}
    },
    {
      "if": {"properties": {"eligibility": {"enum": ["no_menu", "ineligible", "review"]}}},
      "then": {"properties": {"menu_reference": {"type": "null"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "lyrics"}}},
      "then": {"properties": {
        "target": {"properties": {"kind": {"const": "analysis_unit"}}},
        "occurrence_id": {"type": "string", "pattern": "^occurrence_[0-9a-f]{32}$"},
        "context": {"properties": {"kind": {"const": "lyrics_line"}, "song_id": {"type": "string"}}}
      }}
    },
    {
      "if": {"properties": {"mode": {"const": "speech"}}},
      "then": {"properties": {
        "target": {"properties": {"kind": {"const": "sentence_candidate"}}},
        "context": {"properties": {"kind": {"const": "sentence"}}}
      }}
    }
  ]
}
