{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/release-catalog.schema.json",
  "title": "Selectable release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "language", "mode", "active_release_id", "candidates"],
  "properties": {
    "catalog_version": {"const": "release-catalog/v1"},
    "language": {"type": "string", "minLength": 2},
    "mode": {"type": "string", "minLength": 1},
    "active_release_id": {"type": ["string", "null"]},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release_id", "label", "created_at", "publication_status", "card_count", "manifest_path", "deck_content_id", "composition_content_id", "active", "fallback_layers", "wsd_status"],
        "properties": {
          "release_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "created_at": {"type": "string"},
          "publication_status": {"type": "string"},
          "card_count": {"type": "integer", "minimum": 1},
          "manifest_path": {"type": "string"},
          "deck_content_id": {"type": "string"},
          "composition_content_id": {"type": "string"},
          "active": {"type": "boolean"},
          "fallback_layers": {"type": "integer", "minimum": 0},
          "wsd_status": {"type": "string"}
        }
      }
    }
  }
}
