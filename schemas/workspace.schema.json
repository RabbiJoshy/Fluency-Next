{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/workspace.schema.json",
  "title": "Fluency workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "created_at"],
  "properties": {
    "schema_version": {"const": "workspace/v1"},
    "workspace_id": {
      "type": "string",
      "pattern": "^workspace_[0-9a-f]{32}$"
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}

