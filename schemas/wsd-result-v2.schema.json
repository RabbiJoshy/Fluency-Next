{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/wsd-result-v2.schema.json",
  "title": "Mode-neutral WSD result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "result_id", "request_id", "run_id", "language", "mode", "target", "occurrence_id", "surface_card_id", "surface_form", "status", "menu_content_id", "menu_analysis_id", "selected_sense_id", "selected_tuple", "decision_path", "evidence", "confidence", "input_artifact_ids"],
  "properties": {
    "result_version": {"const": "wsd-result/v2"},
    "result_id": {"type": "string", "pattern": "^wsd_result_[0-9a-f]{32}$"},
    "request_id": {"type": "string", "pattern": "^wsd_request_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "mode": {"type": "string", "minLength": 1},
    "target": {"type": "object"},
    "occurrence_id": {"type": "string", "minLength": 1},
    "surface_card_id": {"type": "string", "minLength": 1},
    "surface_form": {"type": "string", "minLength": 1},
    "status": {"enum": ["assigned", "abstained", "rejected", "no_menu", "ineligible", "review", "not_evaluated_example_cap"]},
    "menu_content_id": {"type": ["string", "null"]},
    "menu_analysis_id": {"type": ["string", "null"]},
    "selected_sense_id": {"type": ["string", "null"]},
    "selected_tuple": {"type": ["object", "null"]},
    "decision_path": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "object"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "input_artifact_ids": {"type": "array", "items": {"type": "string"}}
  }
}
