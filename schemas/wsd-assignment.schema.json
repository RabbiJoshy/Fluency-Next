{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/wsd-assignment.schema.json",
  "title": "Final WSD decision for one card and sentence",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignment_version", "card_id", "surface_form", "sentence_id", "status", "sense_menu_content_id", "menu_analysis_id", "selected_sense_id", "selected_tuple", "decision_path", "evidence", "confidence", "model_revisions"],
  "properties": {
    "assignment_version": {"const": "wsd-assignment/v1"},
    "card_id": {"type": "string", "pattern": "^card_[a-z]{2,3}_[0-9a-f]{32}$"},
    "surface_form": {"type": "string", "minLength": 1},
    "sentence_id": {"type": "string", "pattern": "^sentence_[0-9a-f]{32}$"},
    "status": {"enum": ["assigned", "abstained", "rejected", "no_menu", "not_evaluated_example_cap"]},
    "sense_menu_content_id": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "menu_analysis_id": {"type": ["string", "null"], "pattern": "^analysis_[0-9a-f]{32}$"},
    "selected_sense_id": {"type": ["string", "null"]},
    "selected_tuple": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["headword", "part_of_speech"],
          "properties": {
            "headword": {"type": "string", "minLength": 1},
            "part_of_speech": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "decision_path": {"type": "array", "uniqueItems": true, "items": {"enum": ["constrain", "multiword", "gloss", "token_tuple_vote", "leaf_repair", "calibration", "alignment", "commit"]}},
    "evidence": {"type": "object"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "model_revisions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "emitted_level": {"enum": ["leaf", "glosskey", "tuple", "unresolved"]},
    "decision_kind": {"enum": ["deterministic_default", "disambiguated"]},
    "active_selection_projection": {"enum": ["provider_only", "mwe_augmented"]},
    "selection_projections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_only"],
      "properties": {
        "provider_only": {"$ref": "#/$defs/selectionProjection"},
        "mwe_augmented": {"$ref": "#/$defs/selectionProjection"}
      }
    }
  },
  "$defs": {
    "selectionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["menu_analysis_id", "selected_sense_id", "selected_tuple", "source_kind", "selected_score", "runner_up_score", "raw_margin", "rank", "emitted_level", "raw_axis_margins"],
      "properties": {
        "menu_analysis_id": {"type": "string", "pattern": "^analysis_[0-9a-f]{32}$"},
        "selected_sense_id": {"type": "string", "minLength": 1},
        "selected_tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headword", "part_of_speech"],
          "properties": {
            "headword": {"type": "string", "minLength": 1},
            "part_of_speech": {"type": "string", "minLength": 1}
          }
        },
        "source_kind": {"enum": ["provider", "multiword"]},
        "selected_score": {"type": "number"},
        "runner_up_score": {"type": ["number", "null"]},
        "raw_margin": {"type": ["number", "null"]},
        "rank": {"type": "integer", "minimum": 1},
        "emitted_level": {"enum": ["leaf", "glosskey", "tuple", "unresolved"]},
        "raw_axis_margins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaf", "glosskey", "tuple"],
          "properties": {
            "leaf": {"type": "number", "minimum": 0, "maximum": 1},
            "glosskey": {"type": "number", "minimum": 0, "maximum": 1},
            "tuple": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
