{
  "config_version": "harvest-language-policy/v1",
  "policy_id": "nl-v1",
  "language": "nl",
  "normalization": {
    "unicode_form": "NFC",
    "casefold": true,
    "canonical_apostrophe": "'",
    "apostrophe_variants": [
      "’",
      "‘",
      "ʼ",
      "‛",
      "＇"
    ],
    "collapse_whitespace": true
  },
  "matching": {
    "boundary_policy": "unicode_word",
    "token_pattern": "[^\\W\\d_]+(?:['’-][^\\W\\d_]+)*"
  },
  "sentence_rules": {
    "reject_contains_apostrophe": false,
    "reject_contains_hyphen": false,
    "forbidden_substrings": [
      "http://",
      "https://",
      "<",
      ">",
      "♪",
      "♫"
    ]
  },
  "policy_note": "Dutch writes an apostrophe inside ordinary words -- 's morgens, auto's -- so it must never be rejected, and the token pattern keeps it inside a token. Hyphenated compounds (zee-eend) are likewise ordinary."
}
