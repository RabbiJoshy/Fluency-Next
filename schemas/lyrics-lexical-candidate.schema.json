{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/lyrics-lexical-candidate.schema.json",
  "title": "Provider-neutral lexical menu candidate for one Lyrics analysis unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "lexical_candidate_id", "analysis_unit_id", "occurrence_id", "language", "surface_form", "normalized_form", "surface_card_id", "route_id", "route_bucket", "status", "lookup_form", "lookup_card_id", "provider", "menu_analysis_ids", "menu_analysis_count", "menu_sense_count", "reason_codes", "input_artifact_ids"],
  "properties": {
    "record_version": {"const": "lyrics-lexical-candidate/v2"},
    "lexical_candidate_id": {"type": "string", "pattern": "^lexical_[0-9a-f]{32}$"},
    "analysis_unit_id": {"type": "string", "pattern": "^unit_[0-9a-f]{32}$"},
    "occurrence_id": {"type": "string", "pattern": "^occurrence_[0-9a-f]{32}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "surface_form": {"type": "string", "minLength": 1},
    "normalized_form": {"type": "string", "minLength": 1},
    "surface_card_id": {"type": "string", "pattern": "^card_[a-z]{2,3}_[0-9a-f]{32}$"},
    "route_id": {"type": "string", "pattern": "^route_[0-9a-f]{32}$"},
    "route_bucket": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "no_menu", "ineligible", "review"]},
    "lookup_form": {"type": ["string", "null"], "minLength": 1},
    "lookup_card_id": {"type": ["string", "null"], "pattern": "^card_[a-z]{2,3}_[0-9a-f]{32}$"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_adapter", "source_edition", "snapshot_id", "snapshot_content_id", "gloss_language"],
      "properties": {
        "source_adapter": {"type": "string", "minLength": 1},
        "source_edition": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "gloss_language": {"type": "string", "pattern": "^[a-z]{2,3}$"}
      }
    },
    "menu_analysis_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "menu_analysis_count": {"type": "integer", "minimum": 0},
    "menu_sense_count": {"type": "integer", "minimum": 0},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input_artifact_ids": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {
        "lookup_form": {"type": "string", "minLength": 1},
        "lookup_card_id": {"type": "string"},
        "menu_analysis_ids": {"minItems": 1},
        "menu_analysis_count": {"minimum": 1},
        "menu_sense_count": {"minimum": 1}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "no_menu"}}},
      "then": {"properties": {
        "lookup_form": {"type": "string", "minLength": 1},
        "lookup_card_id": {"type": "string"},
        "menu_analysis_ids": {"maxItems": 0},
        "menu_analysis_count": {"const": 0},
        "menu_sense_count": {"const": 0}
      }}
    },
    {
      "if": {"properties": {"status": {"enum": ["ineligible", "review"]}}},
      "then": {"properties": {
        "lookup_form": {"type": "null"},
        "lookup_card_id": {"type": "null"},
        "menu_analysis_ids": {"maxItems": 0},
        "menu_analysis_count": {"const": 0},
        "menu_sense_count": {"const": 0}
      }}
    }
  ]
}
