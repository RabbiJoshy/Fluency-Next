{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/wsd-report.schema.json",
  "title": "Immutable WSD stage report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "run_id", "language", "profile_ids", "input_content_ids", "assignment_counts", "fallbacks"],
  "properties": {
    "report_version": {"const": "wsd-report/v1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "profile_ids": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "input_content_ids": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "assignment_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assigned", "abstained", "rejected", "no_menu"],
      "properties": {
        "assigned": {"type": "integer", "minimum": 0},
        "abstained": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "no_menu": {"type": "integer", "minimum": 0}
      }
    },
    "fallbacks": {"const": []}
  }
}
