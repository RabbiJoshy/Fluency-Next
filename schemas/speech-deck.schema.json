{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/speech-deck.schema.json",
  "title": "Fluency Speech deck",
  "type": "object",
  "additionalProperties": false,
  "required": ["deck_version", "release_id", "language", "mode", "study_structure", "cards"],
  "properties": {
    "deck_version": {"const": "speech-deck/v1"},
    "release_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "mode": {"const": "speech"},
    "study_structure": {"$ref": "study-structure.schema.json"},
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/card"}
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "surface_key", "display_form", "rank", "meanings", "examples"],
      "properties": {
        "card_id": {"type": "string", "pattern": "^card_[a-z]{2,3}_[0-9a-f]{32}$"},
        "surface_key": {"type": "string", "minLength": 1},
        "display_form": {"type": "string", "minLength": 1},
        "rank": {"type": "integer", "minimum": 1},
        "frequency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "primary_count", "aggregate_count"],
          "properties": {
            "basis": {"type": "string", "minLength": 1},
            "primary_count": {"type": "integer", "minimum": 0},
            "aggregate_count": {"type": "integer", "minimum": 0}
          }
        },
        "meanings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/meaning"}
        },
        "examples": {
          "type": "array",
          "items": {"$ref": "#/$defs/example"}
        }
      }
    },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense_id", "part_of_speech", "translation", "assignment_status"],
      "properties": {
        "sense_id": {"type": "string", "minLength": 1},
        "part_of_speech": {"type": "string", "minLength": 1},
        "translation": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "assignment_status": {"type": "string", "minLength": 1}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_id", "sense_id", "target", "english", "provenance"],
      "properties": {
        "example_id": {"type": "string", "minLength": 1},
        "sense_id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "english": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "assignment_method": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "easiness": {"type": "number"}
      }
    }
  }
}
