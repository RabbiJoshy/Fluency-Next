{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/lyrics-release-manifest.schema.json",
  "title": "Immutable Fluency Lyrics catalog release",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "release_id", "mode", "created_at", "publication_status", "catalog_path", "catalog_content_id", "composition_path", "composition_content_id", "artist_count", "languages", "card_count", "assignment_status", "files"],
  "properties": {
    "manifest_version": {"const": "lyrics-release-manifest/v1"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "mode": {"const": "lyrics"},
    "created_at": {"type": "string", "format": "date-time"},
    "publication_status": {"type": "string", "minLength": 1},
    "catalog_path": {"const": "app/config/artists.json"},
    "catalog_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "composition_path": {"const": "composition.json"},
    "composition_content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artist_count": {"type": "integer", "minimum": 1},
    "languages": {"type": "array", "items": {"type": "string", "minLength": 2}, "minItems": 1, "uniqueItems": true},
    "card_count": {"type": "integer", "minimum": 1},
    "assignment_status": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_id", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^app/"},
          "content_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
