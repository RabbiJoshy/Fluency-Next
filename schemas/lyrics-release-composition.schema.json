{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluency.local/schemas/lyrics-release-composition.schema.json",
  "title": "Exact Fluency Lyrics catalog composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["composition_version", "release_id", "mode", "created_at", "publication_status", "conflict_policy", "fallback_policy", "layers", "artists", "omitted_layers"],
  "properties": {
    "composition_version": {"const": "lyrics-release-composition/v1"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "mode": {"const": "lyrics"},
    "created_at": {"type": "string", "format": "date-time"},
    "publication_status": {"type": "string", "minLength": 1},
    "conflict_policy": {"const": "error"},
    "fallback_policy": {"const": "none"},
    "layers": {"type": "object", "minProperties": 1},
    "artists": {"type": "array", "minItems": 1},
    "omitted_layers": {"type": "array"}
  }
}
